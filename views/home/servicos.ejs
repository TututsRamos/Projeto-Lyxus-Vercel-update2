<section
    id="servicos"
    class="servicos">

    <div class="container">

        <div class="center">

            <span class="badge">

                NOSSAS ÁREAS DE ATUAÇÃO

            </span>

            <p class="serv-section-subtitle">

                Escolha uma área para 
                conhecer nosso processo
                de trabalho.

            </p>

        </div>
                <br>
        <div class="grid-4 servicos-grid">

            <div
                class="servico-card ativo"
                data-servico="apps">

                <div class="icon">

                    <i class="ri-smartphone-line"></i>

                </div>

                <h3>

                    Apps

                </h3>

                <p>

                    Android • iOS • Sistemas internos

                </p>

            </div>

            <div
                class="servico-card"
                data-servico="sites">

                <div class="icon">

                    <i class="ri-code-box-line"></i>

                </div>

                <h3>

                    Sites

                </h3>

                <p class="servico-card-site">

                    Landing Pages • Blogs <span class="nao-quebra">• Sistemas</span>

                </p>

            </div>

            <div
                class="servico-card"
                data-servico="design">

                <div class="icon">

                    <i class="ri-palette-line"></i>

                </div>

                <h3>

                    Design

                </h3>

                <p>

                    UI/UX • Identidade Visual

                </p>

            </div>

            <div
                class="servico-card"
                data-servico="marketing">

                <div class="icon">

                    <i class="ri-line-chart-line"></i>

                </div>

                <h3>

                    Marketing

                </h3>

                <p>

                    Redes Sociais • Campanhas

                </p>

            </div>

        </div>

    </div>

    <div id="conteudoServico">

        <%- include("processo") %>

        <%- include("feedback") %>

    </div>

</section>
