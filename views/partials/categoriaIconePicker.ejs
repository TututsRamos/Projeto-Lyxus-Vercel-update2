<%
/*
    Bloco de "ícone / imagem da categoria", usado nos formulários
    de nova categoria e edição de categoria (views/dashboard/categorias).

    Uso: include partials/categoriaIconePicker passando "categoria"
    (o documento da categoria, ou null na tela de criação).

    - "icone": classe da Remix Icon, com preview ao vivo + um seletor
      visual (modal) com ícones comuns da biblioteca pra evitar erro
      de digitação e confirmar que o vetor existe de fato.
    - "imagem": upload opcional que substitui o ícone na exibição.
*/
const _cat = typeof categoria !== "undefined" ? categoria : null;
const _iconeAtual = (_cat && _cat.icone) ? _cat.icone : "";
const _temImagem = !!(_cat && _cat.imagem);
%>

<div class="campo">

    <label for="icone">Ícone (biblioteca Remix Icon)</label>

    <div class="categoria-icone-picker">

        <span
            id="preview-icone"
            class="categoria-icone-preview">
            <i class="<%= _iconeAtual || 'ri-folder-2-line' %>"></i>
        </span>

        <input
            type="text"
            id="icone"
            name="icone"
            value="<%= _iconeAtual %>"
            placeholder="ri-line-chart-line">

        <button type="button" class="btn-secundario-dash" data-modal-abrir="modal-icones">
            <i class="ri-apps-2-line"></i> Escolher ícone
        </button>

    </div>

    <small class="campo-ajuda">
        Digite o nome de uma classe da
        <a href="https://remixicon.com" target="_blank" rel="noopener">RemixIcon</a>
        ou clique em "Escolher ícone". O ícone só aparece no blog se a categoria
        não tiver uma imagem enviada abaixo.
    </small>

</div>

<div class="campo">

    <label for="imagem">Imagem da categoria (opcional)</label>

    <input
        type="file"
        id="imagem"
        name="imagem"
        accept="image/png,image/jpeg,image/webp"
        data-preview="#preview-imagem-categoria">

    <img
        id="preview-imagem-categoria"
        alt=""
        class="categoria-imagem-preview"
        <% if(_temImagem){ %>
            src="<%= urlImagem(_cat.imagem) %>"
            style="display:block;"
        <% } else { %>
            style="display:none;"
        <% } %>>

    <small class="campo-ajuda">
        PNG, JPG ou WEBP, até 5MB. Quando enviada, a imagem substitui o ícone
        acima na exibição da categoria.
    </small>

    <% if(_temImagem){ %>

        <label class="campo campo-checkbox" style="margin-top:6px;">
            <input type="checkbox" id="removerImagem" name="removerImagem" value="true">
            <span style="margin:0;">Remover imagem atual e voltar a usar o ícone</span>
        </label>

    <% } %>

</div>

<!-- Modal do seletor de ícones -->
<div class="console-modal" id="modal-icones">

    <div class="console-modal-conteudo categoria-icone-modal">

        <button class="console-modal-fechar" data-modal-fechar>
            <i class="ri-close-line"></i>
        </button>

        <h3>Escolher ícone</h3>

        <p>Ícones da biblioteca <a href="https://remixicon.com" target="_blank" rel="noopener">RemixIcon</a>, já carregada no site.</p>

        <input
            type="text"
            id="busca-icone"
            class="categoria-icone-busca"
            placeholder="Buscar ícone (ex: gráfico, usuário, seta, foguete...)">

        <div class="categoria-icone-grid" id="grade-icones"></div>

    </div>

</div>

<script src="/js/modal.js"></script>
<script src="/js/categoria-icones.js"></script>
