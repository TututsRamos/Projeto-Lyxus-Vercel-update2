<%
/*
    Banner de consentimento de cookies. Só é renderizado quando o
    usuário ainda não decidiu nesse navegador (cookieConsent é null
    — ver middleware/locals.js). A lógica de aceitar/recusar fica em
    public/js/cookies.js.
*/
%>
<% if(typeof cookieConsent !== "undefined" && !cookieConsent){ %>

    <div class="cookie-banner" id="cookie-banner">

        <div class="cookie-banner-texto">

            <p>
                Usamos cookies próprios e de terceiros para garantir o
                funcionamento do site e, mediante seu consentimento, para
                fins de análise e melhoria da experiência. Você pode aceitar
                ou recusar os cookies não essenciais a qualquer momento.
                Saiba mais na nossa
                <a href="/termos/cookies">Política de Cookies</a>.
            </p>

        </div>

        <div class="cookie-banner-acoes">

            <button type="button" id="cookie-recusar" class="btn-outline">
                Recusar
            </button>

            <button type="button" id="cookie-aceitar" class="btn">
                Aceitar
            </button>

        </div>

    </div>

<% } %>
