<%- include("../partials/head", {
    titulo: "Solicitar Usuário • LYXUS",
    css: "dashboard"
}) %>

<div class="dash-layout">

    <%- include("../partials/sidebarStaff", { atual: "solicitar" }) %>

    <main class="dash-main">

        <header class="dash-header">

            <div>
                <h1>Solicitar Usuário</h1>
                <p>Envie um pedido de criação de usuário para o administrador aprovar.</p>
            </div>

        </header>

        <div class="painel" style="max-width:600px;">

            <% if(typeof enviado !== "undefined" && enviado){ %>

                <div class="inst-form-sucesso">
                    <i class="ri-checkbox-circle-fill"></i>
                    <h3>Solicitação enviada!</h3>
                    <p>O administrador vai analisar e aprovar (ou não) o novo usuário.</p>
                </div>

            <% } else { %>

                <% if(typeof erro !== "undefined" && erro){ %>

                    <div class="login-erro">
                        <i class="ri-error-warning-line"></i>
                        <span><%= erro %></span>
                    </div>

                <% } %>

                <form method="POST" action="/staff/solicitar-usuario" class="form-dashboard">

                    <div class="campo">
                        <label for="nomeUsuario">Nome do usuário</label>
                        <input type="text" id="nomeUsuario" name="nomeUsuario" placeholder="Nome de quem vai acessar" required>
                    </div>

                    <div class="campo">
                        <label for="emailUsuario">E-mail do usuário</label>
                        <input type="email" id="emailUsuario" name="emailUsuario" placeholder="email@cliente.com" required>
                    </div>

                    <div class="campo">
                        <label for="tipoSolicitado">Tipo de acesso</label>
                        <select id="tipoSolicitado" name="tipoSolicitado">
                            <option value="cliente">Cliente</option>
                            <option value="staff">Staff</option>
                        </select>
                    </div>

                    <div class="campo">
                        <label for="observacao">Observação para o admin</label>
                        <textarea id="observacao" name="observacao" placeholder="Contexto: pra qual proposta, urgência, etc."></textarea>
                    </div>

                    <div class="form-dashboard-acoes">
                        <button type="submit" class="btn">Enviar solicitação</button>
                    </div>

                </form>

            <% } %>

        </div>

    </main>

</div>

<%- include("../partials/scripts", { js: "dashboard" }) %>
