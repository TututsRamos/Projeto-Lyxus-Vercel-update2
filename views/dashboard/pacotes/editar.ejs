<%- include("../../partials/head", {
    titulo: "Editar pacote • Dashboard",
    css: "dashboard"
}) %>

<div class="dash-layout">

    <%- include("../../partials/sidebar", { atual: "pacotes" }) %>

    <main class="dash-main">

        <header class="dash-header">

            <div>
                <h1>Editar pacote</h1>
                <p><%= pacote.nome %></p>
            </div>

        </header>

        <div class="painel">

            <form
                method="POST"
                action="/dashboard/pacotes/editar/<%= pacote._id %>"
                enctype="multipart/form-data"
                class="form-dashboard">

                <div class="campo">
                    <label for="nome">Nome do pacote</label>
                    <input type="text" id="nome" name="nome" value="<%= pacote.nome %>" maxlength="60" required>
                    <small>Máximo de 60 caracteres.</small>
                </div>

                <div class="campo">
                    <label for="descricao">Descrição</label>
                    <textarea id="descricao" name="descricao" style="min-height:90px;" required><%= pacote.descricao %></textarea>
                </div>

                <div class="campo-linha">

                    <div class="campo">
                        <label for="preco">Preço (R$)</label>
                        <input type="number" id="preco" name="preco" step="0.01" min="0" value="<%= pacote.preco %>" required>
                    </div>

                    <div class="campo">
                        <label for="destaque">Destacar pacote?</label>
                        <select id="destaque" name="destaque">
                            <option value="false" <%= !pacote.destaque ? "selected" : "" %>>Não</option>
                            <option value="true" <%= pacote.destaque ? "selected" : "" %>>Sim</option>
                        </select>
                    </div>

                </div>

                <div class="campo">
                    <label for="beneficios">Benefícios (um por linha)</label>
                    <textarea id="beneficios" name="beneficios" style="min-height:130px;"><%= (pacote.beneficios || []).join("\n") %></textarea>
                </div>

                <div class="campo">
                    <label for="imagem">Imagem (opcional)</label>
                    <input type="file" id="imagem" name="imagem" accept="image/*" data-preview="#preview-pacote">

                    <% if(pacote.imagem){ %>

                        <img
                            id="preview-pacote"
                            src="<%= urlImagem(pacote.imagem) %>"
                            alt=""
                            style="width:120px;border-radius:12px;object-fit:cover;margin-top:10px;">

                    <% } %>

                </div>

                <div class="campo campo-checkbox">
                    <input type="checkbox" id="ativo" name="ativo" value="true" <%= pacote.ativo ? "checked" : "" %>>
                    <label for="ativo" style="margin:0;">Pacote ativo (visível no site)</label>
                </div>

                <div class="form-dashboard-acoes">
                    <button type="submit" class="btn">Salvar alterações</button>
                    <a href="/dashboard/pacotes" class="btn-secundario-dash">Cancelar</a>
                </div>

            </form>

        </div>

    </main>

</div>

<%- include("../../partials/scripts", {
    js: "dashboard"
}) %>
