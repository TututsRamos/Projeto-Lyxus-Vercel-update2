<%- include("../../partials/head", {
    titulo: "Painel de Usuários • Console Admin",
    css: "dashboard"
}) %>

<div class="dash-layout">

    <%- include("../../partials/sidebar", { atual: "console-usuarios" }) %>

    <main class="dash-main">

        <header class="dash-header">

            <div>
                <h1>Painel de Usuários</h1>
                <p>Todos os usuários já criados, organizados por papel e status.</p>
            </div>

            <div class="dash-header-acoes">

                <% if(solicitacoesPendentes > 0){ %>
                    <a href="/dashboard/console/solicitacoes" class="btn-secundario-dash">
                        <%= solicitacoesPendentes %> solicitação(ões) pendente(s)
                    </a>
                <% } %>

                <a href="/dashboard/usuarios/novo" class="btn">
                    <i class="ri-add-line"></i> Novo usuário
                </a>

            </div>

        </header>

        <!-- ===== Administração ===== -->

        <div class="painel">

            <div class="painel-titulo">
                <h2>Administração</h2>
            </div>

            <div class="console-usuarios-lista">

                <% admins.forEach(a => { %>

                    <button class="console-usuario-item" data-id="<%= a._id %>">
                        <span class="tabela-item">
                            <img src="<%= urlImagem(a.foto) %>" alt="">
                            <%= a.nome %>
                        </span>
                        <span class="status <%= a.tipo === 'master' ? 'status-pendente' : 'status-ativo' %>">
                            <%= a.tipo %>
                        </span>
                    </button>

                <% }) %>

            </div>

        </div>

        <!-- ===== STAFF, por área ===== -->

        <div class="painel">

            <div class="painel-titulo">
                <h2>STAFF</h2>
            </div>

            <% const areas = Object.keys(staffPorArea); %>

            <% if(areas.length === 0){ %>

                <p class="vazio">Nenhum STAFF cadastrado ainda.</p>

            <% } %>

            <% areas.forEach(area => { %>

                <div class="console-grupo">

                    <h4><%= area %></h4>

                    <div class="console-usuarios-lista">

                        <% staffPorArea[area].ativos.forEach(s => { %>

                            <button class="console-usuario-item" data-id="<%= s._id %>">
                                <span class="tabela-item">
                                    <img src="<%= urlImagem(s.foto) %>" alt="">
                                    <%= s.nome %>
                                </span>
                                <span class="status status-ativo">ativo</span>
                            </button>

                        <% }) %>

                        <% staffPorArea[area].inativos.forEach(s => { %>

                            <button class="console-usuario-item inativo" data-id="<%= s._id %>">
                                <span class="tabela-item">
                                    <img src="<%= urlImagem(s.foto) %>" alt="">
                                    <%= s.nome %>
                                </span>
                                <span class="status status-inativo">inativo</span>
                            </button>

                        <% }) %>

                    </div>

                </div>

            <% }) %>

        </div>

        <!-- ===== Clientes ===== -->

        <div class="painel">

            <div class="painel-titulo">
                <h2>Clientes</h2>
            </div>

            <div class="console-grupo">

                <h4>Temporários (com código de vinculação)</h4>

                <div class="console-usuarios-lista">

                    <% clientes.temporarios.ativos.forEach(c => { %>

                        <button class="console-usuario-item" data-id="<%= c._id %>">
                            <span class="tabela-item">
                                <img src="<%= urlImagem(c.foto) %>" alt="">
                                <%= c.nome %>
                            </span>
                            <span class="status status-ativo">ativo</span>
                        </button>

                    <% }) %>

                    <% clientes.temporarios.inativos.forEach(c => { %>

                        <button class="console-usuario-item inativo" data-id="<%= c._id %>">
                            <span class="tabela-item">
                                <img src="<%= urlImagem(c.foto) %>" alt="">
                                <%= c.nome %>
                            </span>
                            <span class="status status-inativo">inativo</span>
                        </button>

                    <% }) %>

                    <% if(!clientes.temporarios.ativos.length && !clientes.temporarios.inativos.length){ %>
                        <p class="vazio">Nenhum cliente temporário.</p>
                    <% } %>

                </div>

            </div>

            <div class="console-grupo">

                <h4>Permanentes</h4>

                <div class="console-usuarios-lista">

                    <% clientes.permanentes.ativos.forEach(c => { %>

                        <button class="console-usuario-item" data-id="<%= c._id %>">
                            <span class="tabela-item">
                                <img src="<%= urlImagem(c.foto) %>" alt="">
                                <%= c.nome %>
                            </span>
                            <span class="status status-ativo">ativo</span>
                        </button>

                    <% }) %>

                    <% clientes.permanentes.inativos.forEach(c => { %>

                        <button class="console-usuario-item inativo" data-id="<%= c._id %>">
                            <span class="tabela-item">
                                <img src="<%= urlImagem(c.foto) %>" alt="">
                                <%= c.nome %>
                            </span>
                            <span class="status status-inativo">inativo</span>
                        </button>

                    <% }) %>

                    <% if(!clientes.permanentes.ativos.length && !clientes.permanentes.inativos.length){ %>
                        <p class="vazio">Nenhum cliente permanente.</p>
                    <% } %>

                </div>

            </div>

        </div>

    </main>

</div>

<!-- ===== Modal com detalhes do usuário ===== -->

<div class="console-modal" id="modal-usuario">

    <div class="console-modal-conteudo">

        <button class="console-modal-fechar" id="fechar-modal-usuario">
            <i class="ri-close-line"></i>
        </button>

        <div id="modal-usuario-corpo">
            <p class="vazio">Carregando...</p>
        </div>

    </div>

</div>

<script>

    const modalUsuario = document.getElementById("modal-usuario");
    const corpoModal = document.getElementById("modal-usuario-corpo");

    document.querySelectorAll(".console-usuario-item").forEach(botao=>{

        botao.addEventListener("click", async ()=>{

            const id = botao.dataset.id;

            corpoModal.innerHTML = '<p class="vazio">Carregando...</p>';
            modalUsuario.classList.add("aberto");

            try{

                const resposta = await fetch("/dashboard/console/usuarios/" + id + "/json");
                const u = await resposta.json();

                if(u.erro){
                    corpoModal.innerHTML = '<p class="vazio">' + u.erro + '</p>';
                    return;
                }

                corpoModal.innerHTML = `
                    <h2 style="margin-bottom:6px;">${u.nome}</h2>
                    <p style="color:var(--texto-claro);margin-bottom:20px;">${u.email}</p>

                    <p><strong>Tipo:</strong> ${u.tipo}</p>
                    <p><strong>Status:</strong> ${u.ativo ? "Ativo" : "Inativo"}</p>
                    <p><strong>CPF:</strong> ${u.cpf || "-"}</p>
                    <p><strong>Contato:</strong> ${u.numeroContato || "-"}</p>
                    <p><strong>Área de atuação:</strong> ${u.areaAtuacao || "-"}</p>
                    <p><strong>Nível de permissão:</strong> ${u.nivelPermissao ?? "-"}</p>
                    <p><strong>Criado por:</strong> ${u.staffCriador ? u.staffCriador.nome : "-"}</p>
                    <p><strong>Código de vinculação:</strong> ${u.codigoVinculacao || "-"}</p>
                    <p><strong>Criado em:</strong> ${new Date(u.createdAt).toLocaleDateString("pt-BR")}</p>

                    <div class="form-dashboard-acoes" style="margin-top:24px;">

                        ${u.tipo !== "master" ? `
                        <form method="POST" action="/dashboard/console/usuarios/${u._id}/ativo">
                            <button type="submit" class="btn-secundario-dash">
                                ${u.ativo ? "Desativar" : "Ativar"}
                            </button>
                        </form>` : ""}

                        <a href="/dashboard/usuarios/editar/${u._id}" class="btn-secundario-dash">Editar</a>

                        ${u.tipo !== "master" ? `
                        <form method="POST" action="/dashboard/console/usuarios/${u._id}/excluir" onsubmit="return confirm('Excluir este usuário? Essa ação não pode ser desfeita.')">
                            <button type="submit" class="btn-secundario-dash" style="color:var(--erro);border-color:var(--erro);">Excluir</button>
                        </form>` : ""}

                    </div>
                `;

            }catch(err){

                corpoModal.innerHTML = '<p class="vazio">Não foi possível carregar os dados.</p>';

            }

        });

    });

    document.getElementById("fechar-modal-usuario").addEventListener("click", ()=>{
        modalUsuario.classList.remove("aberto");
    });

    modalUsuario.addEventListener("click", (e)=>{
        if(e.target === modalUsuario) modalUsuario.classList.remove("aberto");
    });

</script>

<%- include("../../partials/scripts", { js: "dashboard" }) %>
