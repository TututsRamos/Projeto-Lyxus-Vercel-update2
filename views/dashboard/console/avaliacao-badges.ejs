<%- include("../../partials/head", {
    titulo: "Badges Lyxus • Pesquisa e Avaliação",
    css: "dashboard"
}) %>

<div class="dash-layout">

    <%- include("../../partials/sidebar", { atual: "console-avaliacao-badges" }) %>

    <main class="dash-main">

        <header class="dash-header">

            <div>
                <h1>Badges Lyxus</h1>
                <p>Cadastre, edite ou remova badges. A atribuição a cada empresa é feita na ficha dela.</p>
            </div>

        </header>

        <% if(erro){ %>
            <div class="login-erro" style="margin-bottom:20px;"><%= erro %></div>
        <% } %>

        <div class="painel">

            <div class="painel-titulo"><h2>Nova badge</h2></div>

            <form method="POST" action="/dashboard/console/avaliacoes/badges" class="avaliacao-badge-form">

                <div class="campo">
                    <label for="rotulo">Nome</label>
                    <input type="text" id="rotulo" name="rotulo" required placeholder="Ex: Mobile Ready">
                </div>

                <div class="campo">
                    <label for="descricao">Descrição</label>
                    <input type="text" id="descricao" name="descricao" placeholder="Ex: Site funciona muito bem no celular.">
                </div>

                <div class="campo">
                    <label for="tipo">Tipo</label>
                    <select id="tipo" name="tipo">
                        <option value="merito">Mérito técnico</option>
                        <option value="alerta">Alerta</option>
                    </select>
                </div>

                <div class="campo">
                    <label for="ordem">Ordem</label>
                    <input type="number" id="ordem" name="ordem" step="1" value="<%= badges.length + 1 %>">
                </div>

                <button type="submit" class="btn">Salvar badge</button>

            </form>

        </div>

        <div class="painel">

            <div class="painel-titulo"><h2>Badges cadastradas (<%= badges.length %>)</h2></div>

            <% if(!badges.length){ %>

                <p style="color:var(--texto-claro);">Nenhuma badge cadastrada ainda.</p>

            <% } else { %>

                <div class="avaliacao-badges-lista">

                    <% badges.forEach(function(b){ %>

                        <span class="avaliacao-badge-item <%= b.tipo %>" title="<%= b.descricao %>">

                            <i class="<%= b.tipo === 'alerta' ? 'ri-alert-line' : 'ri-shield-check-line' %>"></i>

                            <%= b.rotulo %>

                            <form method="POST" action="/dashboard/console/avaliacoes/badges/<%= b._id %>/excluir" onsubmit="return confirm('Remover a badge &quot;<%= b.rotulo %>&quot;? Ela será desatribuída de todas as empresas.');">
                                <button type="submit" title="Remover"><i class="ri-close-line"></i></button>
                            </form>

                        </span>

                    <% }) %>

                </div>

            <% } %>

        </div>

        <% if(badges.length){ %>

        <div class="painel">

            <div class="painel-titulo"><h2>Editar badge existente</h2></div>

            <% badges.forEach(function(b){ %>

                <form method="POST" action="/dashboard/console/avaliacoes/badges/<%= b._id %>" class="avaliacao-badge-form">

                    <div class="campo">
                        <label>Nome</label>
                        <input type="text" name="rotulo" value="<%= b.rotulo %>" required>
                    </div>

                    <div class="campo">
                        <label>Descrição</label>
                        <input type="text" name="descricao" value="<%= b.descricao %>">
                    </div>

                    <div class="campo">
                        <label>Tipo</label>
                        <select name="tipo">
                            <option value="merito" <%= b.tipo === "merito" ? "selected" : "" %>>Mérito técnico</option>
                            <option value="alerta" <%= b.tipo === "alerta" ? "selected" : "" %>>Alerta</option>
                        </select>
                    </div>

                    <div class="campo">
                        <label>Ordem</label>
                        <input type="number" name="ordem" step="1" value="<%= b.ordem %>">
                    </div>

                    <button type="submit" class="btn-secundario-dash">Salvar</button>

                </form>

            <% }) %>

        </div>

        <% } %>

    </main>

</div>

<%- include("../../partials/scripts", { js: "dashboard" }) %>
