<%- include("../partials/head", {
    titulo: proposta.titulo + " • LYXUS",
    css: "dashboard"
}) %>

<div class="dash-layout">

    <%- include("../partials/sidebarPainel", { atual: "propostas" }) %>

    <main class="dash-main">

        <header class="dash-header">

            <div>
                <h1><%= proposta.titulo %></h1>
                <p>
                    Código <%= proposta.codigo %> •
                    Responsável: <%= proposta.staff ? proposta.staff.nome : "-" %>
                </p>
            </div>

            <div class="dash-header-acoes">
                <span class="status <%=
                    proposta.status === 'aprovada' ? 'status-ativo' :
                    proposta.status === 'recusada' ? 'status-cancelado' :
                    proposta.status === 'cancelada' ? 'status-inativo' : 'status-pendente'
                %>">
                    <%= proposta.status %>
                </span>
            </div>

        </header>

        <div class="painel">

            <div class="painel-titulo">
                <h2>Detalhes da proposta</h2>
            </div>

            <p><strong>Área:</strong> <%= proposta.areaAtuacao %></p>
            <p><strong>Valor do contrato:</strong> R$ <%= Number(proposta.valorContrato).toLocaleString("pt-BR") %></p>

            <p>
                <strong>Prazo:</strong> <%= proposta.prazo || "-" %>
                <% if(proposta.camposEditaveis.includes("prazo")){ %>
                    <span class="status status-ativo" style="margin-left:8px;">editável</span>
                <% } %>
            </p>

            <p>
                <strong>Pagamento inicial:</strong> R$ <%= Number(proposta.pagamentoInicial || 0).toLocaleString("pt-BR") %>
                <% if(proposta.camposEditaveis.includes("pagamentoInicial")){ %>
                    <span class="status status-ativo" style="margin-left:8px;">editável</span>
                <% } %>
            </p>

            <p><strong>Multa:</strong> <%= proposta.percentualMulta || 0 %>%</p>
            <p><strong>Correção:</strong> <%= proposta.percentualCorrecao || 0 %>%</p>

            <% if(proposta.objetivo){ %>
                <p>
                    <strong>Objetivo:</strong> <%= proposta.objetivo %>
                    <% if(proposta.camposEditaveis.includes("objetivo")){ %>
                        <span class="status status-ativo" style="margin-left:8px;">editável</span>
                    <% } %>
                </p>
            <% } %>

            <% if(proposta.detalhes){ %>
                <p>
                    <strong>Detalhes:</strong> <%= proposta.detalhes %>
                    <% if(proposta.camposEditaveis.includes("detalhes")){ %>
                        <span class="status status-ativo" style="margin-left:8px;">editável</span>
                    <% } %>
                </p>
            <% } %>

            <% if(proposta.status === "aberta"){ %>

                <div class="form-dashboard-acoes" style="margin-top:24px;">

                    <form method="POST" action="/painel/propostas/<%= proposta._id %>/aprovar">
                        <button type="submit" class="btn">Aprovar proposta</button>
                    </form>

                    <form method="POST" action="/painel/propostas/<%= proposta._id %>/recusar">
                        <button type="submit" class="btn-secundario-dash">Recusar</button>
                    </form>

                </div>

            <% } %>

        </div>

        <div class="painel">

            <div class="painel-titulo">
                <h2>Histórico</h2>
            </div>

            <div class="tabela-wrap">

                <table class="tabela">

                    <thead>
                        <tr>
                            <th>Evento</th>
                            <th>Autor</th>
                            <th>Data</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% if(proposta.historico && proposta.historico.length){ %>

                            <% proposta.historico.forEach(h => { %>

                                <tr>
                                    <td><%= h.tipo.replace(/_/g," ") %></td>
                                    <td><%= h.autor ? h.autor.nome : "-" %></td>
                                    <td><%= new Date(h.data).toLocaleString("pt-BR") %></td>
                                </tr>

                            <% }) %>

                        <% } else { %>

                            <tr><td colspan="3" class="vazio">Sem eventos registrados ainda.</td></tr>

                        <% } %>

                    </tbody>

                </table>

            </div>

        </div>

    </main>

</div>

<%- include("../partials/scripts", { js: "dashboard" }) %>
